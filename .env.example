# Security and autonomy
CRON_SECRET=
AUTONOMY_HALT=false
RISK_LOOKBACK_DAYS=45
AGENT_STALE_MINUTES=35
AGENT_FAILURE_KILL_THRESHOLD=3
MAX_SHADOW_DRAWDOWN_PCT=12

# Persistent intelligence warehouse
# Recommended: Supabase pooled Postgres connection string, server-side only.
DATABASE_URL=
DATABASE_POOL_MAX=5
DATABASE_IDLE_TIMEOUT_SECONDS=20
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Shadow portfolio and execution research
SHADOW_CAPITAL_BASE=100000
SHADOW_MAX_GROSS_PCT=35
SHADOW_MAX_POSITION_PCT=7.5

# Market data
# MARKET_DATA_PROVIDER: auto | massive | intrinio
MARKET_DATA_PROVIDER=auto
MASSIVE_API_KEY=
INTRINIO_API_KEY=
MARKET_DATA_API_KEY=
MARKET_INGEST_SECRET=
MARKET_PULL_MAX_SYMBOLS=750
MARKET_PULL_CONCURRENCY=8
MARKET_LOOKBACK_MINUTES=5
REGIME_LOOKBACK_MINUTES=30
MARKET_STALE_MINUTES=3

# Historical replay and backfill
HISTORICAL_DATA_PROVIDER=auto
HISTORICAL_BACKFILL_DAYS=365
HISTORICAL_BACKFILL_MAX_DAYS=730
HISTORICAL_BACKFILL_CONCURRENCY=4

# Authoritative open-data mesh
# SEC APIs require no API key but require a descriptive User-Agent.
SEC_USER_AGENT=
SEC_MAX_COMPANIES=25
SEC_FACTS_MAX_COMPANIES=25
# FINRA Reg SHO is a public API dataset; bound the pull to avoid unnecessary payloads.
FINRA_REGSHO_LIMIT=5000
# Optional self-hosted OpenBB REST bridge. Mercury treats it as an aggregation/fallback layer, not authoritative evidence by default.
OPENBB_API_URL=
OPENBB_BASIC_AUTH=

# Regulatory and company intelligence
OTC_MARKETS_API_KEY=
STRUCTURE_INGEST_SECRET=
STRUCTURE_STALE_HOURS=36
FILING_STALE_HOURS=72
CORPORATE_ACTION_INGEST_SECRET=
CORPORATE_ACTION_LOOKBACK_DAYS=60

# Social intelligence, only authorized or permitted access
SOCIAL_INGEST_SECRET=
SOCIAL_LOOKBACK_MINUTES=90
SOCIAL_STALE_MINUTES=20
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
FACEBOOK_ACCESS_TOKEN=

# Operational alerts
ALERT_WEBHOOK_URL=

# AI research and replay layer
OPENAI_API_KEY=
MODEL_VERSION=mercury-live-shadow-v1
LEARNING_LOOKBACK_DAYS=30
