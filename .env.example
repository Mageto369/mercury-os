# Security and autonomy
CRON_SECRET=
AUTONOMY_HALT=false
RISK_LOOKBACK_DAYS=45
AGENT_STALE_MINUTES=35
AGENT_FAILURE_KILL_THRESHOLD=3
MAX_SHADOW_DRAWDOWN_PCT=12

# Persistent intelligence warehouse
# Recommended: Supabase pooled Postgres connection string, server-side only.
DATABASE_URL=
DATABASE_POOL_MAX=5
DATABASE_IDLE_TIMEOUT_SECONDS=20
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Shadow portfolio and execution research
SHADOW_CAPITAL_BASE=100000
SHADOW_MAX_GROSS_PCT=35
